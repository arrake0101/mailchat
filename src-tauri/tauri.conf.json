{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MailChat",
  "version": "0.3.0",
  "identifier": "com.mailchat.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "MailChat",
        "width": 1120,
        "height": 740,
        "minWidth": 820,
        "minHeight": 520,
        "decorations": false,
        "shadow": true
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "app", "dmg", "deb", "appimage"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "macOS": {
      "signingIdentity": "-"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDY2QzU2OUM0NUUyNUI5MjMKUldRanVTVmV4R25GWnI5U3ZUa0tHOUs5U3VTTU1CYXByNkpJNmF3b0tmaHlCRE51RFBFOGZEOHUK",
      "endpoints": [
        "https://github.com/arrake0101/mailchat/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
